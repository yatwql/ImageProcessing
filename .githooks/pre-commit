#!/usr/bin/env sh
# 提交前门禁（P0）：静态检查 + 工程守护 + 全量用例。
#
#   sh .githooks/install-hooks.sh      # 启用（git config core.hooksPath .githooks）
#   IMG_P_SKIP_HOOK=1 git commit ...   # 临时跳过（仅限明确知道后果时）
#
# 与 CI 对齐：`-m src.python.tools.check_all --quick` 跑并发静态检查 + 耗时守卫 + 本机单档用例
# （约 30s；静态检查与用例都并行，worker 数见 src/python/tools/_parallel.py）。
# 只改了非代码文件时直接放行。

set -e
ROOT=$(git rev-parse --show-toplevel)
cd "$ROOT"

if [ "${IMG_P_SKIP_HOOK:-0}" = "1" ]; then
  echo "[pre-commit] IMG_P_SKIP_HOOK=1，跳过"
  exit 0
fi

STAGED=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(py|toml|sh|ps1|yml|yaml|md)$' || true)
[ -z "$STAGED" ] && exit 0

PY=".venv/bin/python"
if [ ! -x "$PY" ]; then
  echo "[pre-commit] 缺少 .venv，先跑 ./scripts/setup.sh（已跳过门禁）" >&2
  exit 0
fi

echo "[pre-commit] check_all --quick（ruff / mypy / guards 并发 → perf → 本机单档用例）"
exec "$PY" -m src.python.tools.check_all --quick
