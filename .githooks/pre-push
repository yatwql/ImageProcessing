#!/usr/bin/env sh
# 推送前门禁：跑与 CI 完全一致的全量检查（覆盖率 + 四档环境矩阵 + 分片重排，约 3 分钟）。
#
#   sh .githooks/install-hooks.sh       # 启用（会同时装上 pre-commit 与 pre-push）
#   IMG_P_SKIP_HOOK=1 git push ...      # 紧急跳过（有理由再用）
#
# 为什么还要 pre-push：pre-commit 为了速度只跑 --quick（本机单档），覆盖率、
# cp1252+C locale、无字体、换字族这几档不跑，而 CI 恰恰在那几档上翻过车。
# 推送前补一次全量，才算"推之前等于 CI"。
set -e
ROOT=$(git rev-parse --show-toplevel)
cd "$ROOT"

if [ "${IMG_P_SKIP_HOOK:-0}" = "1" ]; then
  echo "[pre-push] IMG_P_SKIP_HOOK=1，跳过"
  exit 0
fi

PY=".venv/bin/python"
if [ ! -x "$PY" ]; then
  echo "[pre-push] 缺少 .venv，先跑 ./scripts/setup.sh（已跳过门禁）" >&2
  exit 0
fi

# 同一份代码刚全量通过过就跳过重跑（戳存在 .git 里，和是否提交无关）
if "$PY" -m src.python.tools.gate_stamp --check; then
  echo "[pre-push] 跳过：这份代码已经通过全量门禁（改了东西会自动重跑）"
  exit 0
fi

echo "[pre-push] check_all（全量：静态并发 + 四档环境矩阵 + 覆盖率 + 分片重排）"
exec "$PY" -m src.python.tools.check_all
